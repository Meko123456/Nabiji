# Copy to keystore.properties (git-ignored) and fill in to produce a signed release build.
# Alternatively set NABIJI_KEYSTORE_STORE_FILE / _STORE_PASSWORD / _KEY_ALIAS / _KEY_PASSWORD
# in the environment (that is how .github/workflows/release.yml passes the CI secrets in).
# With neither present, `assembleRelease` still builds — it just produces an unsigned APK.
storeFile=/absolute/path/to/nabiji-release.jks
storePassword=CHANGE_ME
keyAlias=nabiji
keyPassword=CHANGE_ME
